Project vdev_quest {
  database_type: 'PostgreSQL'

  Note: '''
    # vDev Quest — modelo de dados

    Modelo conceitual do futuro banco PostgreSQL, alinhado a
    `docs/database/alteracoes-modelagem-vdev-quest.md` e ao PRD.

    ## Decisões centrais

    - O e-mail é a chave primária de `core.users`; todas as FKs de usuário repetem o e-mail normalizado.
    - As demais entidades usam UUIDv7 para IDs expostos; a decisão do usuário vale apenas para `core.users`.
    - Valores exibidos em português são traduzidos no frontend; o banco usa enums estáveis em inglês.
    - Ranking, mural, feed, iniciais, progresso e `hasProgress` são projeções, não fontes de verdade.
    - Arquivos ficam em object storage. O banco guarda a chave privada do objeto, nunca uma URL assinada temporária.
    - `core.users.xp` é o saldo materializado; `gamification.xp_awards` é o livro-razão imutável (créditos e débitos).
    - A recompensa pertence à fase: `quests.mission_phases.xp_reward`, não à missão inteira.
    - Uma submissão avança por fases; evidências ficam em `quests.submission_phase_evidences`.
    - Não há fila de aprovação: XP é concedido no envio; cancelamento/invalidação gera movimentos negativos.
    - Badges e titles são catálogos independentes com relações de usuário.
    - Todas as tabelas com dados de usuários devem ter RLS na implementação física.

    Consulte `docs/database/README.md` e `docs/database/alteracoes-modelagem-vdev-quest.md`
    para invariantes transacionais, índices parciais e a matriz de acesso.
  '''
}

Enum core.user_role {
  collaborator [note: 'Pode consultar missões, enviar evidências e cancelar as próprias submissões.']
  manager [note: 'Papel de Administrador no produto: cria/edita/invalida missões e invalida submissões.']
}

Enum quests.evidence_type {
  photo [note: 'Foto PNG ou JPEG.']
  pdf
  link
  text
}

Enum quests.mission_status {
  active [note: 'Missão disponível conforme vigência e regras de domínio.']
  invalidated [note: 'Exclusão lógica; não aceita novas submissões.']
}

Enum quests.recurrence_type {
  none
  daily
  weekly
  monthly
}

Enum quests.weekday {
  sunday
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
}

Enum quests.submission_status {
  active [note: 'Submissão válida, em andamento ou na última fase.']
  cancelled [note: 'Cancelada pelo próprio colaborador.']
  invalidated [note: 'Invalidada por administrador ou pela invalidação da missão.']
}

Enum quests.submission_status_change_source {
  user_cancellation
  admin_invalidation
  mission_invalidation
}

Enum gamification.xp_movement_type {
  phase_reward
  checkin_base_reward
  checkin_milestone_reward
  user_cancellation_reversal
  admin_invalidation_reversal
  mission_invalidation_reversal
  checkin_bonus_correction
}

Enum avatar.body_type {
  hero
  heroine
}

Enum avatar.avatar_slot {
  hair
  headwear
  face
  shirt
  pants
  overalls
  skirt
  outer
  socks
  shoes
  boots
  hands
  neck
}

Table core.users {
  name text [not null, note: 'Nome exibido no perfil e no ranking.']
  email text [pk, not null, note: 'Chave primária e e-mail de autenticação; não deve ser exposto na view pública do ranking.']
  xp bigint [not null, default: 0, note: 'Saldo materializado; após cada transação deve igualar a soma de xp_awards.amount do usuário.']
  role core.user_role [not null, default: 'collaborator']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (xp) [name: 'users_xp_desc_idx', note: 'Ordenação do ranking; na migration usar xp DESC.']
  }

  checks {
    `char_length(btrim(name)) > 0` [name: 'users_name_not_blank']
    `email = lower(email) and email = btrim(email)` [name: 'users_email_normalized']
    `position('@' in email) > 1` [name: 'users_email_shape']
    `xp >= 0` [name: 'users_xp_nonnegative']
  }

  Note: '''
    Fonte do `Collaborator` e do nome de `RankingPlayer`.
    `initials` é calculado a partir de `name`; o título do ranking vem do `user_titles` ativo.
    O e-mail é a PK e deve ser normalizado em minúsculas.
    Somente o backend escreve `xp`; o livro-razão em `xp_awards` é a fonte de reconciliação.
    O papel `manager` é apresentado como Administrador no produto.
  '''
}

Table quests.missions {
  id uuid [pk, not null, default: `uuid_generate_v7()`]
  slug text [not null, unique, note: 'Identificador legível opcional para URLs; não substitui a PK.']
  created_by_email text [not null]
  title text [not null]
  description text [not null]
  evidence_type quests.evidence_type [not null]
  start_date date [not null]
  end_date date [not null]
  recurrence_type quests.recurrence_type [not null, default: 'none']
  is_checkin boolean [not null, default: false, note: 'Exige recurrence_type = monthly; start_date = 1º dia e end_date = último dia do mesmo mês.']
  allows_multiple_submissions boolean [not null, default: false, note: 'Permite várias submissões independentes por colaborador (ex.: indicações).']
  status quests.mission_status [not null, default: 'active']
  invalidated_at timestamptz [note: 'Preenchido somente quando status = invalidated.']
  invalidated_by_email text [note: 'Administrador que invalidou; sem justificativa no MVP.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    created_by_email [name: 'missions_created_by_email_idx']
    invalidated_by_email [name: 'missions_invalidated_by_email_idx']
    (status, start_date, end_date) [name: 'missions_availability_idx']
  }

  checks {
    `slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$'` [name: 'missions_slug_format']
    `char_length(btrim(title)) > 0` [name: 'missions_title_not_blank']
    `char_length(btrim(description)) > 0` [name: 'missions_description_not_blank']
    `end_date >= start_date` [name: 'missions_valid_date_range']
    `((status = 'active' and invalidated_at is null and invalidated_by_email is null) or (status = 'invalidated' and invalidated_at is not null and invalidated_by_email is not null))` [name: 'missions_invalidation_consistent']
    `(is_checkin = false or recurrence_type = 'monthly')` [name: 'missions_checkin_requires_monthly']
  }

  Note: '''
    Fonte persistente de `Mission` e `MuralMission`; fases e recompensas ficam em `mission_phases`.
    Sem rascunho/publicação: status é `active` ou `invalidated`.
    Toda missão tem ao menos uma fase; recorrente ou check-in tem exatamente uma.
    Semanal exige dias em `mission_weekdays`; demais tipos não.
    Após a primeira submissão, evidência, fases, XP, recorrência, dias, datas, check-in e multiplicidade ficam imutáveis.
    Unicidade de check-in por mês/ano: índice parcial
    `missions_one_checkin_per_month_uidx` sobre extract(year/month de start_date) WHERE is_checkin.
    Não criar coluna `checkin_month`.
  '''
}

Table quests.mission_phases {
  mission_id uuid [not null]
  phase_number integer [not null]
  xp_reward integer [not null]
  phase_title text [not null]

  Indexes {
    (mission_id, phase_number) [pk, name: 'mission_phases_pk']
  }

  checks {
    `phase_number > 0` [name: 'mission_phases_number_positive']
    `xp_reward > 0` [name: 'mission_phases_xp_reward_positive']
    `char_length(btrim(phase_title)) > 0` [name: 'mission_phases_title_not_blank']
  }

  Note: '''
    Etapas ordenadas e sequenciais sem lacunas; `phase_number` começa em 1.
    `xp_reward` é copiado para o livro-razão no momento do avanço; o valor histórico não muda depois.
    Fases não são atualizadas nem removidas após a primeira submissão da missão.
  '''
}

Table quests.mission_weekdays {
  mission_id uuid [not null]
  weekday quests.weekday [not null]

  Indexes {
    (mission_id, weekday) [pk, name: 'mission_weekdays_pk']
  }

  Note: '''
    Dias usados somente por missões com recorrência semanal.
    Cada dia selecionado gera uma ocorrência independente (ex.: segunda e quarta = uma submissão válida por segunda e por quarta).
    Regra transacional: ao menos um dia para `weekly` e nenhum dia para os demais tipos.
  '''
}

Table quests.submissions {
  id uuid [pk, not null, default: `uuid_generate_v7()`]
  mission_id uuid [not null]
  current_phase integer [not null, default: 1, note: 'Fase atual desta submissão; avança apenas para current_phase + 1.']
  collaborator_email text [not null]
  occurrence_date date [note: 'Obrigatória para recorrência e check-in; nula em missão não recorrente.']
  status quests.submission_status [not null, default: 'active']
  status_changed_at timestamptz [note: 'Nulo enquanto active.']
  status_changed_by_email text [note: 'Colaborador (cancelamento) ou administrador (invalidação); nulo enquanto active.']
  status_change_source quests.submission_status_change_source [note: 'Nulo enquanto active.']
  invalidation_justification text [note: 'Obrigatória apenas em invalidação administrativa direta (admin_invalidation).']
  submitted_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (mission_id, collaborator_email, current_phase, submitted_at) [name: 'submissions_fifo_active_idx', note: 'Na migration: partial WHERE status = active; FIFO por submitted_at e desempate por id.']
    (collaborator_email, submitted_at) [name: 'submissions_collaborator_history_idx']
    (mission_id, collaborator_email, occurrence_date) [name: 'submissions_one_active_occurrence_uidx', note: 'Na migration: unique partial WHERE status = active AND occurrence_date IS NOT NULL.']
    (mission_id, collaborator_email, status) [name: 'submissions_mission_collaborator_status_idx', note: 'Apoia verificação de unicidade quando allows_multiple_submissions = false.']
    status_changed_by_email [name: 'submissions_status_changed_by_email_idx']
  }

  checks {
    `((status = 'active' and status_changed_at is null and status_changed_by_email is null and status_change_source is null and invalidation_justification is null) or (status = 'cancelled' and status_changed_at is not null and status_changed_by_email is not null and status_change_source = 'user_cancellation' and invalidation_justification is null) or (status = 'invalidated' and status_changed_at is not null and status_changed_by_email is not null and status_change_source in ('admin_invalidation', 'mission_invalidation')))` [name: 'submissions_status_state_consistent']
    `((status_change_source = 'admin_invalidation' and invalidation_justification is not null and char_length(btrim(invalidation_justification)) > 0) or (status_change_source is distinct from 'admin_invalidation' and invalidation_justification is null))` [name: 'submissions_invalidation_justification_matches_source']
  }

  Note: '''
    Uma linha por submissão completa que avança por fases (não uma linha por fase).
    Evidências ficam em `submission_phase_evidences`; importação `.xlsx` não cria evidência.
    `cancelled` exige ator = collaborator_email; `invalidated` por missão não exige justificativa.
    Submissão encerrada não volta a `active` no MVP; cancelada/invalida libera a ocorrência para novo envio.
    Unicidade de missão não recorrente/não múltipla é regra transacional com lock da missão.
  '''
}

Table quests.submission_phase_evidences {
  submission_id uuid [not null]
  phase_number integer [not null]
  evidence_value text [note: 'Texto ou URL; nulo para arquivo.']
  attachment_object_key text [note: 'Chave privada do objeto; nulo para texto/link.']
  original_file_name text
  mime_type text
  file_size_bytes bigint
  submitted_at timestamptz [not null, default: `now()`]

  Indexes {
    (submission_id, phase_number) [pk, name: 'submission_phase_evidences_pk']
  }

  checks {
    `file_size_bytes is null or (file_size_bytes > 0 and file_size_bytes <= 3145728)` [name: 'submission_phase_evidences_file_size_limit']
    `((attachment_object_key is not null and evidence_value is null and original_file_name is not null and mime_type is not null and file_size_bytes is not null) or (attachment_object_key is null and evidence_value is not null and char_length(btrim(evidence_value)) > 0 and original_file_name is null and mime_type is null and file_size_bytes is null))` [name: 'submission_phase_evidences_payload_shape']
  }

  Note: '''
    Uma evidência por submissão/fase, somente quando o mural envia evidência.
    Fase importada por planilha não cria linha vazia.
    Tipo exigido vem de `missions.evidence_type` (foto: png/jpeg; PDF; link HTTP(S); texto não vazio).
    `phase_number` deve pertencer à missão da submissão (regra transacional).
  '''
}

Table avatar.slot_definitions {
  slot avatar.avatar_slot [pk, not null]
  label text [not null]
  asset_directory text [not null]
  draw_order smallint [not null, unique]
  icon_code text [not null]

  checks {
    `draw_order >= 0` [name: 'slot_definitions_draw_order_nonnegative']
  }

  Note: 'Catálogo de `ManaSeedSlotDefinition`; pode ser semeado a partir de `src/mocks/data/mana-seed.ts`.'
}

Table avatar.items {
  id uuid [pk, not null, default: `uuid_generate_v7()`]
  slot avatar.avatar_slot [not null]
  code text [not null]
  label text [not null]
  file_path text [not null]
  shaped_file_path text
  under_file_path text
  hides_hair boolean [not null, default: false]
  hidden_by_hats boolean [not null, default: false]

  Indexes {
    (slot, code) [unique, name: 'avatar_items_slot_code_uidx']
    (id, slot) [unique, name: 'avatar_items_id_slot_uidx']
  }

  checks {
    `char_length(btrim(code)) > 0` [name: 'avatar_items_code_not_blank']
    `char_length(btrim(file_path)) > 0` [name: 'avatar_items_file_path_not_blank']
  }

  Note: 'Catálogo de `ManaSeedItem`. As imagens continuam em storage/CDN; a tabela guarda apenas metadados e caminhos.'
}

Table avatar.user_avatars {
  user_email text [pk, not null]
  body_type avatar.body_type [not null, default: 'hero']
  skin_color_index smallint [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `skin_color_index >= 0` [name: 'user_avatars_skin_color_nonnegative']
  }

  Note: 'Configuração 1:1 que persiste `bodyType` e a cor da pele do personagem.'
}

Table avatar.user_slot_settings {
  user_email text [not null]
  slot avatar.avatar_slot [not null]
  item_id uuid [note: 'Nulo significa que nenhuma peça está equipada no slot.']
  color_index smallint [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_email, slot) [pk, name: 'user_slot_settings_pk']
    (item_id, slot) [name: 'user_slot_settings_item_slot_idx']
    slot [name: 'user_slot_settings_slot_idx']
  }

  checks {
    `color_index >= 0` [name: 'user_slot_settings_color_nonnegative']
  }

  Note: '''
    Representa `ManaSeedAppearance` e `ManaSeedColors` sem JSONB: uma linha por slot e usuário.
    A FK composta garante que uma peça só possa ser equipada no slot ao qual pertence.
  '''
}

Table gamification.levels {
  level smallint [pk, not null]
  minimum_xp bigint [not null, unique]
  label text [not null, note: 'Nome da faixa de nível; não é o title do usuário.']

  checks {
    `level > 0` [name: 'levels_level_positive']
    `minimum_xp >= 0` [name: 'levels_minimum_xp_nonnegative']
    `char_length(btrim(label)) > 0` [name: 'levels_label_not_blank']
  }

  Note: 'Faixas usadas para derivar `level` e `progress` a partir do total de EXP. Titles são modelados separadamente. Administrada diretamente no banco.'
}

Table gamification.badges {
  id uuid [pk, not null, default: `uuid_generate_v7()`]
  code text [not null, unique, note: 'Valores iniciais: champion, guardian, arcane e streak.']
  label text [not null]
  description text
  image_path text [not null, note: 'Caminho informado pelo administrador; validação de formato/existência na aplicação.']

  checks {
    `char_length(btrim(code)) > 0` [name: 'badges_code_not_blank']
    `char_length(btrim(label)) > 0` [name: 'badges_label_not_blank']
    `char_length(btrim(image_path)) > 0` [name: 'badges_image_path_not_blank']
  }
}

Table gamification.titles {
  id uuid [pk, not null, default: `uuid_generate_v7()`]
  code text [not null, unique, note: 'Gerado pelo backend na criação.']
  label text [not null]
  description text

  checks {
    `char_length(btrim(code)) > 0` [name: 'titles_code_not_blank']
    `char_length(btrim(label)) > 0` [name: 'titles_label_not_blank']
  }

  Note: 'Catálogo de títulos que podem ser conquistados e exibidos no ranking.'
}

Table gamification.user_badges {
  user_email text [not null]
  badge_id uuid [not null]
  granted_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_email, badge_id) [pk, name: 'user_badges_pk']
    badge_id [name: 'user_badges_badge_id_idx']
  }

  Note: 'Permanece para leitura; não há atribuição no MVP.'
}

Table gamification.user_titles {
  user_email text [not null]
  title_id uuid [not null]
  is_active boolean [not null, default: false, note: 'O title que a API exibe em `RankingPlayer.title`.']
  granted_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_email, title_id) [pk, name: 'user_titles_pk']
    title_id [name: 'user_titles_title_id_idx']
  }

  Note: '''
    Relação muitos-para-muitos entre usuários e titles. Um usuário pode possuir vários,
    mas deve haver no máximo um `is_active = true` por usuário (índice único parcial na migration).
    Permanece para leitura; não há atribuição no MVP.
  '''
}

Table gamification.xp_awards {
  id uuid [pk, not null, default: `uuid_generate_v7()`]
  user_email text [not null]
  submission_id uuid [not null, note: 'Obrigatório para os movimentos do MVP.']
  phase_number integer [note: 'Nulo apenas quando não houver fase aplicável.']
  amount integer [not null, note: 'Positivo (recompensa) ou negativo (reversão/correção); nunca zero.']
  movement_type gamification.xp_movement_type [not null]
  related_award_id uuid [note: 'FK ao movimento positivo compensado; preenchido em reversões.']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_email, created_at) [name: 'xp_awards_user_created_idx']
    (submission_id, created_at) [name: 'xp_awards_submission_created_idx']
    related_award_id [name: 'xp_awards_related_award_idx']
  }

  checks {
    `amount <> 0` [name: 'xp_awards_amount_nonzero']
  }

  Note: '''
    Livro-razão imutável: movimentos não são alterados nem apagados.
    Recompensa = positivo; cancelamento, invalidação e correção = negativo.
    Movimento negativo que desfaz uma concessão aponta para ela via `related_award_id`.
    Mês de check-in vem de `submissions.occurrence_date`; não duplicar period_month, actor_email ou reason.
    Idempotência: a mesma recompensa/reversão não pode ser aplicada duas vezes.
  '''
}

Ref mission_created_by: quests.missions.created_by_email > core.users.email [delete: restrict, update: cascade]
Ref mission_invalidated_by: quests.missions.invalidated_by_email > core.users.email [delete: restrict, update: cascade]
Ref mission_phase_mission: quests.mission_phases.mission_id > quests.missions.id [delete: cascade, update: no action]
Ref mission_weekdays_mission: quests.mission_weekdays.mission_id > quests.missions.id [delete: cascade, update: no action]

Ref submission_mission: quests.submissions.mission_id > quests.missions.id [delete: restrict, update: no action]
Ref submission_current_phase: quests.submissions.(mission_id, current_phase) > quests.mission_phases.(mission_id, phase_number) [delete: restrict, update: no action]
Ref submission_collaborator: quests.submissions.collaborator_email > core.users.email [delete: restrict, update: cascade]
Ref submission_status_changed_by: quests.submissions.status_changed_by_email > core.users.email [delete: restrict, update: cascade]

Ref submission_phase_evidence_submission: quests.submission_phase_evidences.submission_id > quests.submissions.id [delete: restrict, update: no action]

Ref avatar_item_slot: avatar.items.slot > avatar.slot_definitions.slot [delete: restrict, update: no action]
Ref user_avatar_user: core.users.email - avatar.user_avatars.user_email [delete: cascade, update: cascade]
Ref user_slot_user: avatar.user_slot_settings.user_email > core.users.email [delete: cascade, update: cascade]
Ref user_slot_definition: avatar.user_slot_settings.slot > avatar.slot_definitions.slot [delete: restrict, update: no action]
Ref user_slot_item: avatar.user_slot_settings.(item_id, slot) > avatar.items.(id, slot) [delete: restrict, update: no action]

Ref user_badge_user: gamification.user_badges.user_email > core.users.email [delete: cascade, update: cascade]
Ref user_badge_badge: gamification.user_badges.badge_id > gamification.badges.id [delete: restrict, update: no action]
Ref user_title_user: gamification.user_titles.user_email > core.users.email [delete: cascade, update: cascade]
Ref user_title_title: gamification.user_titles.title_id > gamification.titles.id [delete: restrict, update: no action]

Ref xp_award_user: gamification.xp_awards.user_email > core.users.email [delete: restrict, update: cascade]
Ref xp_award_submission: gamification.xp_awards.submission_id > quests.submissions.id [delete: restrict, update: no action]
Ref xp_award_related: gamification.xp_awards.related_award_id > gamification.xp_awards.id [delete: restrict, update: no action]

TableGroup "Identidade e acesso" [color: #326CE5] {
  core.users

  Note: 'Contas e papéis que sustentam autorização e RLS.'
}

TableGroup "Missões e submissões" [color: #E6A23C] {
  quests.missions
  quests.mission_phases
  quests.mission_weekdays
  quests.submissions
  quests.submission_phase_evidences

  Note: 'Definição das missões, fases, agenda semanal, submissões e evidências por fase.'
}

TableGroup "Avatar Mana Seed" [color: #8E44AD] {
  avatar.slot_definitions
  avatar.items
  avatar.user_avatars
  avatar.user_slot_settings

  Note: 'Catálogo visual e escolhas persistidas dos personagens.'
}

TableGroup "Gamificação" [color: #2E8B57] {
  gamification.levels
  gamification.badges
  gamification.user_badges
  gamification.titles
  gamification.user_titles
  gamification.xp_awards

  Note: 'Saldo de EXP, livro-razão, níveis, badges e titles do ranking.'
}
