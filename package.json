{
    "name": "vdev-quest",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.3.8",
    "scripts": {
        "dev": "vite",
        "build": "vite build && tsc --noEmit",
        "format": "prettier --write . && (eslint . --fix 2>&1 | grep -v 'baseline-browser-mapping' || true) && tsc -b",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "bun test --preload=./test/setup-test-env.ts"
    },
    "dependencies": {
        "@tanstack/react-router": "1.168.26",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "eslint": "^10.8.1",
        "framer-motion": "^13.1.0",
        "prettier": "^3.9.6",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@rolldown/binding-win32-x64-msvc": "^1.2.4",
        "@tailwindcss/vite": "4.3.3",
        "@tanstack/router-plugin": "1.168.26",
        "@types/node": "26.2.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitejs/plugin-react": "6.0.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "eslint-plugin-unused-imports": "^4.2.0",
        "globals": "^16.3.0",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.39.0",
        "vite": "8.2.1"
    }
}
